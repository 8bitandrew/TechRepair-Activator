<Window x:Class="TechRepairActivator.MainWindow" ResizeMode="CanResize" MinHeight="250" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TechRepairActivator"
        mc:Ignorable="d"
        Title="TechRepair Account Activator" Height="250" Width="420">

    <DockPanel LastChildFill="True" Background = "AliceBlue">
        <TextBlock x:Name="WindowsVersionTextBlock" HorizontalAlignment="Center" DockPanel.Dock="Top"/>
        <Button Click="AcceptButton_Click" Content="Submit" Margin="10" Height="Auto" Width="Auto" DockPanel.Dock="Bottom"/>
        <Grid x:Name = "FormLayoutGrid" Background = "AliceBlue" Width="Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width = "Auto" />
                <ColumnDefinition />
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height = "Auto" />
                <RowDefinition Height = "Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row = "0" Grid.Column = "0" Margin = "10"  
                       HorizontalAlignment = "Left" VerticalAlignment = "Center" Width = "100">
            Username<LineBreak/>(Client Name)
            </TextBlock>
            <TextBox x:Name="userBox" Grid.Row = "0" Grid.Column = "1" Margin = "10" VerticalAlignment="Center" />
            <TextBlock Grid.Row = "1" Grid.Column = "0" Margin = "10"  
                       HorizontalAlignment = "Left" VerticalAlignment = "Center" Width = "100">
            Password<LineBreak/>(ePanther)
            </TextBlock>
            <TextBox x:Name="passwordBox" Grid.Row = "1" Grid.Column = "1" Margin = "10" VerticalAlignment="Center"/>

            <TextBlock Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="Auto" Height="Auto">
                Instructions: 
                <LineBreak/>
                1. Copy program folder 
                <LineBreak/>
                to client's desktop
                <LineBreak/>
                2. Right click on program,
                <LineBreak/>
                select run as Administrator
                <LineBreak/>
                3. Enter client info, submit
            </TextBlock>
        </Grid>

    </DockPanel>
</Window>
